{
  "manifest_version": 3,
  "name": "Syncro Stripe Payments & Terminal",
  "version": "1.1",
  "description": "Trigger Stripe S700 payments and email ACH/Credit Card payment links directly from Syncro MSP invoices.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "https://*.syncromsp.com/*",
    "https://*/*"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": ["https://*.syncromsp.com/invoices/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
